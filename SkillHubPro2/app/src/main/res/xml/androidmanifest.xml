<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.skillhub">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.SkillHub">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" />
        <activity android:name=".RegisterActivity" />
        <activity android:name=".LearnerDashboardActivity" />
        <activity android:name=".InstructorDashboardActivity" />
        <activity android:name=".CourseListActivity" />
        <activity android:name=".PostCourseActivity" />

        <!-- NEW ACTIVITIES -->
        <activity android:name=".InstructorCourseListActivity" />
        <activity android:name=".LearnerEnrolledCoursesActivity" />
        <activity android:name=".PaymentActivity" />

    </application>

</manifest>
