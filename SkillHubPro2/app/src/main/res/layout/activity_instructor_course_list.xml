<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/instructor_course_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="top|center_horizontal">

    <!-- Logo ImageView -->
    <ImageView
        android:id="@+id/Logo"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginBottom="12dp"
        android:adjustViewBounds="true"
        android:contentDescription="App Logo"
        android:src="@drawable/logo" />

    <!-- Instructor Course List Title -->
    <TextView
        android:id="@+id/tvInstructorCourseListTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Posted Courses"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <!-- RecyclerView for courses -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInstructorCourses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <!-- Back button -->
    <Button
        android:id="@+id/btnInstructorBackToDash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Dashboard"
        android:layout_marginTop="8dp" />

</LinearLayout>
