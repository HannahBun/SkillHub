<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/payment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Logo ImageView -->
        <ImageView
            android:id="@+id/Logo"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginBottom="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="App Logo"
            android:src="@drawable/logo" />

        <!-- Payment Title -->
        <TextView
            android:id="@+id/tvPaymentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Course Title -->
        <TextView
            android:id="@+id/tvPaymentCourseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Course Title"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <!-- Course Price -->
        <TextView
            android:id="@+id/tvPaymentCoursePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textSize="16sp"
            android:layout_marginBottom="18dp" />

        <!-- Card Name -->
        <EditText
            android:id="@+id/etCardName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Name on card"
            android:inputType="textPersonName"
            android:layout_marginBottom="8dp" />

        <!-- Card Number -->
        <EditText
            android:id="@+id/etCardNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Card number (16 digits)"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <!-- Expiration Month/Year -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etExpMonth"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="MM"
                android:inputType="number"
                android:maxLength="2"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etExpYear"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="YYYY"
                android:inputType="number"
                android:maxLength="4" />
        </LinearLayout>

        <!-- CVV -->
        <EditText
            android:id="@+id/etCvv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="CVV (3 digits)"
            android:inputType="number"
            android:maxLength="3"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Pay Now Button -->
        <Button
            android:id="@+id/btnPayNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pay Now" />

    </LinearLayout>
</ScrollView>
