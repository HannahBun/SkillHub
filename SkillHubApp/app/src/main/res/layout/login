<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F6FA">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_to_skillhub"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/choose_how_you_want_to_explore_the_platform"
            android:textColor="#616161"
            android:textSize="16sp" />

        <!-- Cards Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="707dp"
            android:layout_marginTop="50dp"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Student Portal Card -->

            <!-- Instructor Portal Card -->

            <androidx.cardview.widget.CardView
                android:id="@+id/studentCard"
                android:layout_width="300dp"
                android:layout_height="331dp"
                android:layout_margin="16dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true"
                tools:ignore="MissingClass,TextSizeCheck">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Icon -->
                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/circle_light_blue"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/icon"
                        android:textColor="#607D8B"
                        android:textSize="28sp" />

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/student_portal"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Bullet points -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/browse_thousands_of_courses"
                        android:textColor="#757575" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/track_your_learning_progress"
                        android:textColor="#757575" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/get_personalized_recommendations"
                        android:textColor="#757575" />

                    <!-- Button -->
                    <Button
                        android:id="@+id/btnStudent"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="#0A66FF"
                        android:text="@string/continue_as_student"
                        android:textColor="#FFFFFF" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/instructorCard"
                android:layout_width="300dp"
                android:layout_height="323dp"
                android:layout_margin="16dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Icon -->
                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/circle_light_purple"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/ic2"
                        android:textColor="#1E88E5"
                        android:textSize="28sp" />

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/instructor_portal"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Bullets -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/create_and_manage_courses"
                        android:textColor="#757575" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/track_revenue_and_analytics"
                        android:textColor="#757575" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/engage_with_your_students"
                        android:textColor="#757575" />

                    <!-- Button -->
                    <Button
                        android:id="@+id/btnInstructor"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="#8E44FB"
                        android:text="@string/continue_as_instructor"
                        android:textColor="#FFFFFF" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
