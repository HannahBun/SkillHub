<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TOP NAV BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="50dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/shlogo"
                android:src="@drawable/Logo" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/notify"
                android:src="@drawable/ic_notification"
                android:tint="#000000"
                android:layout_marginEnd="12dp" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/profile"
                android:src="@drawable/ic_profile"
                android:tint="#000000" />

        </LinearLayout>

        <!-- NAV TITLE BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/browse"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginEnd="28dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_courses"
                android:textStyle="bold"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- SEARCH BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@drawable/search_ic"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/srch"
                android:src="@drawable/ic_search"
                android:tint="#888888" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:autofillHints="name"
                android:background="@android:color/transparent"
                android:hint="@string/search_for_courses"
                android:inputType="text"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:textColorHint="#A1887F"
                tools:ignore="RtlSymmetry,TouchTargetSizeCheck,VisualLintTextFieldSize" />
        </LinearLayout>

        <!-- CONTINUE LEARNING TITLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/continue_learning"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_all"
                android:textColor="#2563EB"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- COURSE LIST VERTICAL -->
        <LinearLayout
            android:id="@+id/courseContainer"
            android:layout_width="match_parent"
            android:layout_height="700dp"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <include layout="@layout/course_item"/>

            <!-- COURSE CARD 2 -->
            <include layout="@layout/course_item2"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>